ENV=development
LOG_LEVEL=INFO
LOG_FILE=/data-lake/logs/pfein-backend.log

MONGO_URI=mongodb://mongo:27017
MONGO_DB=pfein

ML_ARTIFACTS_DIR=app/ml/artifacts
ML_MODEL_FILE=model.joblib

INGESTION_STATE_COLLECTION=ingestion_jobs
DATA_LAKE_DIR=/data-lake
FINANCIAL_SOURCE_ARCHIVE_DIR=/source-archives/financials/data_gouv
FINANCIAL_EXPORT_DATASET_SLUG=financial_data_lake_export

SCHEDULER_TIMEZONE=UTC

CORS_ORIGINS=["http://localhost:4200"]

COMPANY_COLLECTION=company_registry
PREDICTION_RESULTS_COLLECTION=prediction_results

BODACC_INIT_BASE_URL=https://echanges.dila.gouv.fr/OPENDATA/BODACC/FluxHistorique/
BODACC_INIT_DATA_DIR=/source-archives/bodacc
BODACC_IMPORTS_COLLECTION=bodacc_imports
BODACC_ANNONCES_COLLECTION=bodacc_annonces
BODACC_INIT_FILES_COLLECTION=bodacc_historical_archive_files
BODACC_INIT_DATASET_SLUG=bodacc_init
BODACC_INIT_MAX_FILES_PER_RUN=0
BODACC_INIT_DELETE_AFTER_INGEST=false
BODACC_CURRENT_BASE_URL=https://echanges.dila.gouv.fr/OPENDATA/BODACC/FluxAnneeCourante/
BODACC_CURRENT_DATA_DIR=/source-archives/bodacc/current
BODACC_CURRENT_FILES_COLLECTION=bodacc_current_archive_files
BODACC_CURRENT_DATASET_SLUG=bodacc_current
BODACC_CURRENT_MAX_FILES_PER_RUN=0
BODACC_CURRENT_DELETE_AFTER_INGEST=false
BODACC_LABEL_EXPORT_DATASET_SLUG=bodacc_current_label_export
BODACC_LABEL_EXPORT_PROGRESS_FILE=/data-lake/raw/bodacc/current_label_export_progress_v2.json
BODACC_LABEL_EXPORT_BATCH_SIZE=100000
BODACC_HTTP_TIMEOUT_SECONDS=180
BODACC_DEBUG_BAD_XML_ENABLED=false
BODACC_DEBUG_BAD_XML_DIR=/source-archives/bodacc/debug_bad_xml
BODACC_DEBUG_SAMPLE_XML_ENABLED=false
BODACC_DEBUG_SAMPLE_XML_DIR=/source-archives/bodacc/debug_xml_samples
BODACC_DEBUG_SAMPLE_XML_MAX_PER_FAMILY=3

# INPI RNE bulk ingestion via FTP/SFTP — DO NOT commit real credentials.
# Set protocol to "ftp" or "sftp". Default port 21 for ftp, 22 for sftp.
INPI_FTP_HOST=
INPI_FTP_PORT=21
INPI_FTP_USER=
INPI_FTP_PASSWORD=
INPI_FTP_PROTOCOL=ftp
INPI_REMOTE_BASE_DIR=/
INPI_LOCAL_DATA_DIR=/source-archives/inpi
INPI_DELETE_AFTER_INGEST=false
INPI_FTP_TIMEOUT=600
# Optional fnmatch pattern to restrict ingested files. Leave empty to use the
# default extension allowlist (.zip / .json[.gz] / .ndjson[.gz] / .jsonl[.gz]).
# Example: "*.zip" to only ingest ZIP archives.
INPI_REMOTE_INCLUDE_GLOB=
INPI_SOURCE_DOWNLOAD_DATASET_SLUG=inpi_source_download
INPI_PARQUET_EXPORT_DATASET_SLUG=inpi_parquet_export
INPI_PARQUET_EXPORT_PROGRESS_FILE=/data-lake/raw/inpi/parquet_export_progress.json
INPI_PARQUET_EXPORT_BATCH_SIZE=100000

INSEE_BULK_DATASET_SLUG=base-sirene-des-entreprises-et-de-leurs-etablissements-siren-siret
INSEE_BULK_SOURCE_DIR=/source-archives/insee/bulk
INSEE_BULK_EXPORT_DATASET_SLUG=insee_bulk_export
API_RETRY_MAX_ATTEMPTS=5
API_RETRY_BASE_DELAY_SECONDS=2.0
API_RETRY_MAX_DELAY_SECONDS=60.0
