ENV=development
LOG_LEVEL=INFO

MONGO_URI=mongodb://mongo:27017
MONGO_DB=pfein

ML_ARTIFACTS_DIR=app/ml/artifacts
ML_MODEL_FILE=model.joblib

SCHEDULER_TIMEZONE=UTC

CORS_ORIGINS=["http://localhost:4200"]

COMPANY_COLLECTION=companies
COMPANY_SYNC_STATE_COLLECTION=company_sync_state
COMPANY_SYNC_ENABLED=true
COMPANY_SYNC_CRON_HOUR=2
COMPANY_SYNC_CRON_MINUTE=0

BODACC_BASE_URL=https://bodacc-datadila.opendatasoft.com
BODACC_DATASET=annonces-commerciales
BODACC_API_VERSION=v2.1
BODACC_LIMIT=100
BODACC_WHERE=
BODACC_MAX_PAGES=0
BODACC_SLEEP_SECONDS=0.25

# INPI RNE bulk ingestion via FTP/SFTP — DO NOT commit real credentials.
# Set protocol to "ftp" or "sftp". Default port 21 for ftp, 22 for sftp.
INPI_FTP_HOST=
INPI_FTP_PORT=21
INPI_FTP_USER=
INPI_FTP_PASSWORD=
INPI_FTP_PROTOCOL=ftp
INPI_REMOTE_BASE_DIR=/
INPI_LOCAL_DATA_DIR=/app/data/inpi
INPI_DELETE_AFTER_INGEST=false
INPI_RNE_DATASET_SLUG=inpi_rne_bulk
INPI_RNE_COLLECTION=rne_companies
INPI_RNE_FILES_COLLECTION=inpi_rne_files
INPI_RNE_BATCH_SIZE=1000
INPI_RNE_CRON_HOUR=2
INPI_RNE_CRON_MINUTE=30
INPI_RNE_ENABLED=true
INPI_RNE_MAX_FILES_PER_RUN=0
INPI_FTP_TIMEOUT=600
# Optional fnmatch pattern to restrict ingested files. Leave empty to use the
# default extension allowlist (.zip / .json[.gz] / .ndjson[.gz] / .jsonl[.gz]).
# Example: "*.zip" to only ingest ZIP archives.
INPI_REMOTE_INCLUDE_GLOB=

INPI_BASE_URL=https://registre-national-entreprises.inpi.fr
INPI_ENDPOINT=/api/companies
INPI_USERNAME=
INPI_PASSWORD=
INPI_PER_PAGE=100
INPI_START_PAGE=1
INPI_MAX_PAGES=0
INPI_SLEEP_SECONDS=0.35

INSEE_BASE_URL=https://api.insee.fr/api-sirene/3.11/siren
INSEE_API_KEY=
INSEE_QUERY=
INSEE_PAGE_SIZE=1000
INSEE_MAX_PAGES=0
INSEE_SLEEP_SECONDS=1.5
API_RETRY_MAX_ATTEMPTS=5
API_RETRY_BASE_DELAY_SECONDS=2.0
API_RETRY_MAX_DELAY_SECONDS=60.0
